          "refId": "A",
          "legendFormat": "{{exported_namespace}}/{{name}}"
        }
      ],
      "description": "Sawtooth is healthy: it counts down to zero, cert-manager reissues, and it jumps back to ~30d. A line that goes and stays negative is a stuck renewal."
    },
