      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "certmanager_certificate_expiration_timestamp_seconds - time()",
          "refId": "A",
          "legendFormat": "{{exported_namespace}}/{{name}}"
        }
      ],
      "description": "exported_namespace, not namespace: the Certificate's own namespace is renamed on scrape because it collides with the Kubernetes SD target label (honorLabels is false)."
    },
