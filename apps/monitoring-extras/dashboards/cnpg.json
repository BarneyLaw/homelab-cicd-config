    {
      "type": "timeseries",
      "id": 17,
      "title": "Buffer cache hit ratio",
      "description": "clamp_min guards the idle case where both rates are zero and the ratio would be NaN. Postgres-cache only \u2014 OS page cache is not counted, so a low value on a small database is not alarming.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
