          "editorMode": "code",
          "expr": "sum by (cluster) (rate(cnpg_pg_stat_database_blks_hit{namespace=~\"$namespace\", cluster=~\"$cluster\"}[5m])) / clamp_min(sum by (cluster) (rate(cnpg_pg_stat_database_blks_hit{namespace=~\"$namespace\", cluster=~\"$cluster\"}[5m])) + sum by (cluster) (rate(cnpg_pg_stat_database_blks_read{namespace=~\"$namespace\", cluster=~\"$cluster\"}[5m])), 1)",
