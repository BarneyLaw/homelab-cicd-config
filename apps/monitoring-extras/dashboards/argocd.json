      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(argocd_app_info{health_status=~\"Degraded|Missing\"}) or vector(0)",
          "range": false,
          "instant": true,
