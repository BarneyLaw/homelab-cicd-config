{
  "uid": "homelab-cloudflared",
  "title": "Cloudflared Tunnel",
  "description": "Edge-connection health for the in-cluster cloudflared connectors. Deliberately does not duplicate Traefik: request rates, status codes and request latency live in the Traefik dashboard, measured one hop closer to the app.",
  "tags": [
    "homelab",
    "cloudflared",
    "ingress"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Edge connections per connector",
      "description": "Healthy = 4 QUIC connections per pod, one per edge colo. Below 4 is degraded redundancy, not an outage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudflared_tunnel_ha_connections",
          "legendFormat": "{{pod}}",
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Total connections to edge",
      "description": "0 here means Cloudflare is serving error 1033 \u2014 no connectors registered.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              },
              {
                "color": "green",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cloudflared_tunnel_ha_connections)",
          "legendFormat": "connections",
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Ingress config version",
      "description": "Every connector must show the same number. Divergence = a missed config push, or a connector on the wrong tunnel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudflared_orchestration_config_version",
          "legendFormat": "{{pod}}",
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Connectors up",
      "description": "Scrape-level pod count. Falls to 0 before CloudflaredMetricsMissing fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(cloudflared_tunnel_ha_connections)",
          "legendFormat": "pods",
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Edge connections over time",
      "description": "Dips during kured drains are expected. Sustained dips below 4 mean QUIC handshake trouble \u2014 check for UDP/7844 blocking.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudflared_tunnel_ha_connections",
          "legendFormat": "{{pod}}",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 5
    },
    {
      "type": "table",
      "title": "Edge colocations",
      "description": "Which Cloudflare edge locations each connector is pinned to. Table format so it renders regardless of the label names this cloudflared version emits.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "endpoint": true,
              "container": true,
              "service": true,
              "namespace": true
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "cloudflared_tunnel_server_locations",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Origin connect latency",
      "description": "Time for cloudflared to open a stream to Traefik. This is the cost of the pod -> ClusterIP -> Traefik-on-deus hop that the old host-local setup did not pay. VERIFY the unit: if values look ~1000x off, the histogram is in milliseconds \u2014 change unit to ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(cloudflared_proxy_connect_latency_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(cloudflared_proxy_connect_latency_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(cloudflared_proxy_connect_latency_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Origin stream errors",
      "description": "Non-zero means cloudflared reached the edge but could not reach Traefik. Check the origin URL in the tunnel's public hostname config.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cloudflared_proxy_connect_streams_errors[5m])",
          "legendFormat": "{{pod}}",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Tunnel request rate",
      "description": "MAY BE PERMANENTLY FLAT. These counters appear stale in the QUIC proxy path on 2026.8.2. If so, delete this panel \u2014 Traefik measures the same traffic one hop closer to the app, with status codes and latency that cloudflared does not expose.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cloudflared_tunnel_total_requests[5m])",
          "legendFormat": "{{pod}} total",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "rate(cloudflared_tunnel_request_errors[5m])",
          "legendFormat": "{{pod}} errors",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Concurrent requests",
      "description": "In-flight requests per connector. Same staleness caveat as request rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudflared_tunnel_concurrent_requests_per_tunnel",
          "legendFormat": "{{pod}}",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "WARP-routing sessions",
      "description": "Private-network (warp-routing) sessions. warp-routing is enabled on this tunnel, so non-zero values here are legitimate rather than a bug.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudflared_tcp_active_sessions",
          "legendFormat": "{{pod}} tcp",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "cloudflared_udp_active_sessions",
          "legendFormat": "{{pod}} udp",
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "id": 11
    }
  ]
}